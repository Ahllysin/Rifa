# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.
TITULO=Rifa do Ahllysin
PREMIO=Prêmio: R$ 500,00 no PIX
TOTAL=100
PRECO=10
ADMIN_SENHA=troque-esta-senha

# --- Confirmação automática (Mercado Pago) ---
# Access Token: Suas integrações > sua aplicação > Credenciais de teste (comece por ele).
# Só troque pelo de PRODUÇÃO (Credenciais de produção) depois de testar tudo.
MP_ACCESS_TOKEN=
# Endereço público do site, sem barra no final (o MP chama /api/webhook/mp nele)
PUBLIC_URL=https://seusite.com.br
# "Assinatura secreta": Suas integrações > sua aplicação > Webhooks
MP_WEBHOOK_SECRET=

# --- Só para o modo manual (sem Mercado Pago) ---
PIX_CHAVE=
PIX_NOME=SEU NOME
PIX_CIDADE=SAO PAULO

# --- Aparência do site (opcionais) ---
DESCRICAO=Participe e concorra! Cada número ajuda a nossa causa.
DATA_SORTEIO=30/11/2026 às 20h
# WhatsApp do organizador, com 55 + DDD (aparece no rodapé)
WHATSAPP=

# Só estes IPs acessam o /admin (separe por vírgula). Veja o seu em https://api.ipify.org
ADMIN_IPS=
# Em Render/Railway (atrás de proxy), ligue para o site enxergar o IP real do visitante:
# TRUST_PROXY=1

# Prêmio também à venda direta por este valor (aviso no site). 0 ou vazio = sem aviso.
VENDA_DIRETA=

# --- Publicação (Render + Supabase) ---
# Supabase: Project Settings > API. A service_role é SECRETA: só no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
